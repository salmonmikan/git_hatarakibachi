{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hatarakibachi-worker",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-06-10",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "env": {
    "staging": {
      "workers_dev": true,
      "preview_urls": true,
      "routes": [
        {
          "pattern": "staging.hatarakibachi.com/*",
          "zone_name": "hatarakibachi.com"
        }
      ]
    },
    "production": {
      "workers_dev": true,
      "preview_urls": true,
      "routes": [
        {
          "pattern": "hatarakibachi.com/*",
          "zone_name": "hatarakibachi.com"
        }
      ]
    }
  }
}
