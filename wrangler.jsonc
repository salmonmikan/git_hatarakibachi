{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hatarakibachi-worker",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-19",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
